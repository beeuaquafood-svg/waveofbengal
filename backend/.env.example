# ========================================
# WAVE OF BENGAL - BACKEND ENV CONFIG
# ========================================
# Copy this file to .env and fill in your values

# Firebase Configuration (Required)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=wave-of-bengal

# Email Service (Gmail - Required)
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-app-password
# Note: Use Gmail App Password, not your regular password
# Generate: https://myaccount.google.com/apppasswords

# AI Service - Groq (Required)
GROQ_API_KEY=your-groq-api-key
# Get key from: https://console.groq.com

# Database Configuration (Optional - SQLite by default)
# DATABASE_URL=sqlite:///./wave_of_bengal.db

# CORS Configuration (Production)
CORS_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com
# For development: CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# API Configuration (Optional)
API_PORT=8000
API_HOST=0.0.0.0
# ENVIRONMENT=production  # Set to 'production' for production deployment
