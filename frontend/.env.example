# Firebase client configuration (public values; required at build time)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server-only JSON service account. Never prefix these secrets with NEXT_PUBLIC.
FIREBASE_SERVICE_ACCOUNT=
# Start in Razorpay test mode. Enable only after deployment acceptance checks.
COMMERCE_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
COMMERCE_CRON_SECRET=
DELIVERY_PINCODES=700001
# Customer-initiated WhatsApp link (country code, digits only)
WHATSAPP_BUSINESS_NUMBER=
# Optional automatic notification from your Business sender to your opted-in merchant number.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_MERCHANT_NUMBER=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_VERSION=
# Recipe generation
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Existing support forms
GMAIL_USER=
GMAIL_PASS=
SUPPORT_EMAIL=

# Optional legacy analytics backend. Leave empty to disable in production.
NEXT_PUBLIC_API_URL=
